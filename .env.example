# Set these two to persist to Supabase. Omit both for the in-memory demo store.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
LEADS_TABLE=leads

# Require Clay to send this header on every request. Leave empty to disable the
# check (demo only; set it before anything real).
CLAY_SECRET=

# Local dev server port.
PORT=8788
